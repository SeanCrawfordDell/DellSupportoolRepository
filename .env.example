# GitHub API Configuration
# Copy this file to .env and add your actual values
# DO NOT commit .env to git (it's in .gitignore)

# GitHub Personal Access Token
# Create at: https://github.com/settings/tokens
# Required scopes: repo, issues
VITE_GITHUB_TOKEN=your_github_token_here

# GitHub Repository Information
VITE_GITHUB_REPO_OWNER=SeanCrawfordDell
VITE_GITHUB_REPO_NAME=DellSupportoolRepository

# Optional: Repository ID (numeric)
# Get from: https://api.github.com/repos/SeanCrawfordDell/DellSupportoolRepository
VITE_GITHUB_REPO_ID=
